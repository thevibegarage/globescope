# Copy to .env and adjust. Every value here is optional.
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/opencam.db

INGEST_INTERVAL_MIN=180      # re-pull the camera registry from all sources
HEALTH_INTERVAL_MIN=20       # start a liveness sweep this often
HEALTH_CONCURRENCY=48        # total parallel probes across all hosts
HEALTH_PER_HOST=8            # parallel probes against any one upstream host
HEALTH_TIMEOUT_MS=12000
STALE_AFTER_MIN=90           # unchanged frame for this long => "frozen"
OFFLINE_AFTER_FAILS=2        # consecutive failures before a camera leaves the map
FRAME_CACHE_SEC=8            # server-side reuse window for a fetched frame

# Turn sources off by id, comma separated:
# DISABLED_SOURCES=ga511,fl511

# Optional worldwide webcams — free key at https://api.windy.com/keys
# Free tier: image URLs expire after 10 min (handled by a resolver) and listing
# offset is capped at 1000, so the adapter queries country by country.
# Verify with: npm run windy:check
# WINDY_API_KEY=
# WINDY_COUNTRIES=IN,JP,TH,DE,FR,IT,BR     # optional: override the default list
