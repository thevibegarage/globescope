# Linux 24x7 install:
#   sudo cp deploy/globescope.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now globescope
[Unit]
Description=Globescope public camera map
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=globescope
WorkingDirectory=/opt/globescope
ExecStart=/usr/bin/node src/server.js
EnvironmentFile=-/opt/globescope/.env
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/globescope/data

[Install]
WantedBy=multi-user.target
